# Copy into the deployment environment; replace all example values before use.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-generated-outside-source-control
DJANGO_ALLOWED_HOSTS=clinic.example.com,api.clinic.example.com

# Exact browser origins, including scheme. Use HTTPS origins in production.
CORS_ALLOWED_ORIGINS=https://reception.clinic.example.com,https://doctor.clinic.example.com,https://admin.clinic.example.com,https://pharmacy.clinic.example.com,https://login.clinic.example.com,https://laboratory.clinic.example.com
CSRF_TRUSTED_ORIGINS=https://reception.clinic.example.com,https://doctor.clinic.example.com,https://admin.clinic.example.com,https://pharmacy.clinic.example.com,https://login.clinic.example.com,https://laboratory.clinic.example.com

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false

# Set these in the protected deployment environment; never commit real values.
DB_NAME=clinic_database
DB_USER=clinic_application_user
DB_PASSWORD=replace-outside-source-control
DB_HOST=database.example.internal
DB_PORT=3306
DB_SSL_CA=/etc/ssl/certs/clinic-database-ca.pem
